# TMDB API v4 Read Access Bearer Token (REQUIRED for recommendation & discovery)
# Obtain from: https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_bearer_token_here

# Optional: Production site URL for OpenGraph and Canonical metadata
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
